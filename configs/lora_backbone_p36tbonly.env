# Backbone profile: 36M TrueBones-only REST-demo model (runs/v2_p36_tbonly_rest, final = 60k steps on all 802
# captioned Truebones clips, no val). Same architecture / demo condition as the p36rest profile. Used for the
# first-validation probe that measures the FK-pose gap on the four rigs' val clips with the SAME code path as
# the other backbones' "before adaptation" numbers (val at epoch 5 of the adapter run). Source AFTER the view profile.
INIT=${INIT:-runs/v2_p36_tbonly_rest/last_model.pt}
DIM=384; DEPTH=8; HEADS=6; QK_NORM=1; GRAD_CKPT=${GRAD_CKPT:-0}
DEMO_REST=1; DEMO_FRAMES=1
BB_TAG=p36tbonly
