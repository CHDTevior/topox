# Backbone profile: 36M pilot, 1-frame REST demo (runs/v2_noik_pilot36m_r1acc, best = ep399). Source AFTER the
# view profile. OUT gets a backbone tag so the run12 / demo-64 LoRAs of the same rig never share a dir.
INIT=${INIT:-runs/v2_noik_pilot36m_r1acc/best_model.pt}
DIM=384; DEPTH=8; HEADS=6; QK_NORM=1; GRAD_CKPT=${GRAD_CKPT:-0}
DEMO_REST=1; DEMO_FRAMES=1
BB_TAG=p36rest
