\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Text-to-motion generation on the validation set (3{,}899 clips over 311 rigs; 60 pools of 64, 20 steps, $s{=}2$; Table~\ref {tab:pool} gives the other pool sizes). Each model row is the mean over five sampling seeds with the half-width of the 95\% interval; the reference row scores the real clips with the same evaluator in the same pools. R-precision is text$\rightarrow $motion; Match is the mean text--motion cosine; FID is on the evaluator's normalised embeddings; Diversity ($\rightarrow $: nearer the real clips' value) and MModality follow \citet  {guo2022generating} (App.~\ref {app:metrics}).}}{7}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{7}{Text-to-motion generation on the validation set (\num {3{,}899} clips over \num {311} rigs; 60 pools of 64, 20 steps, $s{=}2$; Table~\ref {tab:pool} gives the other pool sizes). Each model row is the mean over five sampling seeds with the half-width of the 95\% interval; the reference row scores the real clips with the same evaluator in the same pools. R-precision is text$\rightarrow $motion; Match is the mean text--motion cosine; FID is on the evaluator's normalised embeddings; Diversity ($\rightarrow $: nearer the real clips' value) and MModality follow \citet {guo2022generating} (App.~\ref {app:metrics})}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Sampling cost and quality against the number of Euler steps ($s{=}2$, seed 42, validation set; runs at 10 and 5 steps are stamped as protocol variants). Latency: batch 1, one H200, fp32, 240 padded frames, 38 joints.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:cost}{{2}{7}{Sampling cost and quality against the number of Euler steps ($s{=}2$, seed 42, validation set; runs at 10 and 5 steps are stamped as protocol variants). Latency: batch 1, one H200, fp32, 240 padded frames, 38 joints}{table.2}{}}
