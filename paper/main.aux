\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Text-to-motion generation on the validation set (\textcolor {blue}{3{,}899} clips over \textcolor {blue}{311} rigs; 60 pools of 64, 20 steps, $s{=}2$, one seed; App.~\ref {app:split} gives the other pool sizes). The reference row scores the real clips with the same evaluator in the same pools. R-precision is text$\rightarrow $motion; Match is the mean text--motion cosine; FID is on the evaluator's normalised embeddings (lower is better).}}{8}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{8}{Text-to-motion generation on the validation set (\num {3{,}899} clips over \num {311} rigs; 60 pools of 64, 20 steps, $s{=}2$, one seed; App.~\ref {app:split} gives the other pool sizes). The reference row scores the real clips with the same evaluator in the same pools. R-precision is text$\rightarrow $motion; Match is the mean text--motion cosine; FID is on the evaluator's normalised embeddings (lower is better)}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Seven generated clips of five library rigs, rendered on the game meshes. For travelling actions, four to five poses at equal distances along the root path, shaded from light (first) to dark (last), with the root trajectory and its direction on the ground; for actions on the spot, four frames at equal times from one fixed camera. The ground plane sits at the level the feet occupy most often; the water plane in the swimming clip is placed just below the root. Captions are the clips' own.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:qual}{{2}{8}{Seven generated clips of five library rigs, rendered on the game meshes. For travelling actions, four to five poses at equal distances along the root path, shaded from light (first) to dark (last), with the root trajectory and its direction on the ground; for actions on the spot, four frames at equal times from one fixed camera. The ground plane sits at the level the feet occupy most often; the water plane in the swimming clip is placed just below the root. Captions are the clips' own}{figure.2}{}}
